{
    "version": 1,
    "disable_existing_loggers": false,
    "filters": {
        "correlation_id": {
            "()": "asgi_correlation_id.CorrelationIdFilter",
            "uuid_length": 8
        }
    },
    "formatters": {
        "standard": {
            "format": "%(asctime)s [%(levelname)s] [%(correlation_id)s] %(name)s: %(message)s"
        }
    },
    "handlers": {
        "file": {
            "class": "logging.handlers.RotatingFileHandler",
            "filename": "app.log",
            "formatter": "standard",
            "filters": [
                "correlation_id"
            ],
            "maxBytes": 10485760,
            "backupCount": 5
        }
    },
    "root": {
        "handlers": [
            "file"
        ],
        "level": "INFO"
    }
}